{
  "name": "sotto-vscode",
  "displayName": "Sotto",
  "description": "Sotto integration for Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "getsotto",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/getsotto/sotto-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/getsotto/sotto-vscode/issues"
  },
  "homepage": "https://github.com/getsotto/sotto-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onTaskType:sotto",
    "onCommand:sotto.addTask"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sotto.addTask",
        "title": "Add Task",
        "category": "Sotto",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sotto.addTask",
          "when": "isWorkspaceTrusted"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "sotto",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The executable to run with Sotto."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments passed to the executable."
          },
          "environment": {
            "type": "string",
            "description": "Optional Sotto environment override."
          }
        }
      }
    ],
    "configuration": {
      "title": "Sotto",
      "properties": {
        "sotto.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute path to Sotto CLI 0.9.0 or newer. Defaults to resolving sotto from VS Code's PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile && npm run compile-tests && node dist-test/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
